{
  "name": "sports-price-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "start": "node src/server.mts",
    "demo": "node src/server.mts --demo",
    "test": "node --import ./tests/offline.mjs --test tests/scraping/*.test.mjs tests/app/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "test:ui": "node --test tests/ui/*.test.mjs"
  },
  "dependencies": {
    "cheerio": "1.1.2",
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "5.9.3"
  }
}
